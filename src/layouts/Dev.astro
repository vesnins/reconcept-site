---
// Лендинги /services/development (К15) и /services/paid-search (Я5): визуал по мотивам asktori.ai в инверсии (синий фон, белые линии); общие cookie/Метрика сайта (scripts/site.ts)
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/jetbrains-mono/wght-italic.css';
import '../styles/dev.css';
import { SITE, INDEX } from '../lib/site';

interface Props { title: string; description: string; og: string; noindex?: boolean }
const { title, description, og, noindex } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), SITE.url).href;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {(!INDEX || noindex) && <meta name="robots" content="noindex,nofollow">}
  <meta name="theme-color" content="#2563eb">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ru_RU">
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={`${SITE.url}/og/${og}.png`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={title}>
  <meta name="twitter:card" content="summary_large_image">
  <slot name="head" />
</head>
<body data-ym={import.meta.env.PUBLIC_YM_ID ?? ''}>
  <slot />
  <div class="cookie" id="cookie" role="region" aria-label="Файлы cookie" hidden><p>Сайт использует cookie и Яндекс Метрику, чтобы становиться удобнее. <a href="/privacy">Подробнее</a></p><button type="button" id="ck-yes">ок</button></div>
  <slot name="after" />
  <script src="../scripts/site.ts"></script>
</body>
</html>
