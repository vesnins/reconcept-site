---
import Base from '../../layouts/Base.astro';
import Blocks from '../../components/Blocks.astro';
import { servicePages } from '../../data/service-pages';
import type { Page } from '../../data/blocks';

export const getStaticPaths = () => Object.entries(servicePages).map(([slug, page]) => ({ params: { slug }, props: { page } }));
const { page } = Astro.props as { page: Page };
---
<Base title={page.title} description={page.description}>
  <Blocks blocks={page.blocks} title={page.title} />
</Base>
