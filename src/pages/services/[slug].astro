---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { servicePages, type Block, type ServicePage } from '../../data/service-pages';

export const getStaticPaths = () => Object.entries(servicePages).map(([slug, page]) => ({ params: { slug }, props: { page } }));
const { page } = Astro.props as { page: ServicePage };

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/svc/*.{jpg,png,webp}', { eager: true });
const pic = (n: string) => Object.entries(files).find(([p]) => p.includes(`/svc/${n}.`))?.[1].default;
const pad = (b: Block) => 'pad' in b ? [`--pt:${b.pad[0]}px`, `--pb:${b.pad[1]}px`, b.pad[2] != null && `--ptm:${b.pad[2]}px`, b.pad[3] != null && `--pbm:${b.pad[3]}px`, 'bg' in b && b.bg && `background:${b.bg}`].filter(Boolean).join(';') : undefined;
---
<Base title={page.title} description={page.description}>
  {page.blocks.map((b) => <>
    {b.k === 'hero' && <section class="sb sh" style={pad(b)}>
      <h1 class="sh__h">{b.h}</h1>
      {b.price && <p class="sh__p">{b.price}</p>}
      <a class="pill pill--fill sh__btn" href="#contacts">консультация<i aria-hidden="true"></i></a>
    </section>}
    {b.k === 'video' && <section class="sb" style={pad(b)}><div class="sv" style={b.ratio && `aspect-ratio:${b.ratio}`}><iframe src={`https://kinescope.io/embed/${b.id}?autoplay=1&muted=1&loop=1`} title={page.title} loading="lazy" allow="autoplay; fullscreen; picture-in-picture; encrypted-media"></iframe></div></section>}
    {b.k === 'cols' && <section class="sb sc" style={pad(b)}>{b.html.map((h) => <p class="sx" set:html={h} />)}</section>}
    {b.k === 'feat' && <section class="sb sf" style={pad(b)}>
      <h2 class="s-h sf__h">{b.h}</h2>
      <ul class="sf__list">{b.items.map((t) => <li class="sx" set:html={t} />)}</ul>
    </section>}
    {b.k === 'title' && <section class="sb" style={pad(b)}><h2 class="s-h">{b.h}</h2></section>}
    {b.k === 'store' && <section class="st">{b.cards.map((c) => { const img = pic(c.img); const Tag = c.href ? 'a' : 'div'; return (
      <Tag class="st__card" href={c.href} target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noopener' : undefined}>
        {img ? <Image class="st__img" src={img} alt={c.t} widths={[640, 960, 1280]} sizes="(max-width:959px) calc(100vw - 40px), calc(50vw - 30px)" loading="lazy" /> : <span class="st__img" />}
        <span class="st__t">{c.t}</span><span class="st__d">{c.d}</span>
      </Tag>); })}</section>}
    {b.k === 'steps' && <section class="ps"><div class="ps__in">
      <h2 class="ps__h">Процесс</h2>
      <ol class="ps__list">{b.items.map((s, i) => <li class="ps__i"><span class="ps__n">{i}</span><div class="ps__c"><h3 class="ps__t">{s.t}</h3><p class="ps__d" set:html={s.d} /></div></li>)}</ol>
      {b.cta && <a class="pill pill--fill ps__cta" href="#contacts">консультация<i aria-hidden="true"></i></a>}
    </div></section>}
    {b.k === 'faq' && <section class="fq">{b.items.map(([q, a]) => <details class="fq__i"><summary class="fq__q">{q}<span class="fq__ic" aria-hidden="true"></span></summary><div class="fq__w"><p class="fq__a" set:html={a} /></div></details>)}</section>}
  </>)}
</Base>
<script>
// FAQ: плавное открытие/закрытие 0.5 с
const rm = matchMedia('(prefers-reduced-motion:reduce)');
document.querySelectorAll<HTMLDetailsElement>('.fq__i').forEach((d) => {
  const w = d.querySelector<HTMLElement>('.fq__w')!;
  let a: Animation | undefined;
  d.querySelector('summary')!.addEventListener('click', (e) => {
    e.preventDefault();
    const close = d.classList.contains('is-open');
    d.classList.toggle('is-open', !close);
    if (rm.matches) { d.open = !close; return; }
    const from = a ? w.offsetHeight : close ? w.scrollHeight : 0;
    a?.cancel();
    d.open = true;
    a = w.animate({ height: [`${from}px`, `${close ? 0 : w.scrollHeight}px`] }, { duration: 500, easing: 'ease' });
    a.onfinish = () => { a = undefined; if (close) d.open = false; };
  });
});
</script>
<style is:global>
/* Страница услуги — Tilda Zero-блоки services/* (rec2847104301 и др.) */
.sb{padding:var(--pt,0) 20px var(--pb,0)}
.s-h{color:#000;font-size:50px;line-height:1.4;font-weight:400}
.sx{color:#000;font-size:16px;line-height:1.8}
/* hero */
.sh{display:flex;flex-direction:column;align-items:flex-start;gap:30px}
.sh__h{max-width:1195px;color:#000;font-size:50px;line-height:1.4;font-weight:400}
.sh__p{color:var(--gray);font-size:16px;line-height:1.8}
.sh__btn{margin-top:20px}
/* видео */
.sv{aspect-ratio:16/10;overflow:hidden;border-radius:20px;box-shadow:0 10px 40px rgba(0,11,48,.25)}
.sv iframe{display:block;width:100%;height:100%;border:0}
/* две колонки текста, преимущества */
.sc,.sf,.sf__list{display:flex;gap:20px}
.sc>*,.sf>*{flex:1;min-width:0}
.sf__list{flex-wrap:wrap;gap:40px 20px}
.sf__list>li{width:calc(50% - 10px)}
/* карточки проектов (Tilda T786) */
.st{display:grid;grid-template-columns:1fr 1fr;gap:20px;padding:0 20px}
.st__card{display:flex;flex-direction:column}
.st__img{display:block;width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:20px 20px 0 0;background:#ebebeb}
.st__t{padding-top:15px;color:#000;font-size:30px;line-height:1.4}
.st__d{padding-top:5px;color:var(--gray);font-size:16px;line-height:1.8}
/* процесс: сетка Tilda фиксированной ширины */
.ps{--W:1680px;--gl:445px;--tl:37px;--nw:385px;--cw:790px;--nf:100px}
.ps__in{display:grid;grid-template-columns:var(--gl) auto;width:var(--W);margin:0 auto;padding-top:90px}
.ps__h{grid-column:1;grid-row:1;padding-left:var(--tl);color:#000;font-size:50px;line-height:1.4;font-weight:400}
.ps__list{display:contents}
.ps__i{grid-column:2;display:grid;grid-template-columns:var(--nw) var(--cw);column-gap:21px;padding-bottom:60px}
.ps__i:first-child{grid-row:1}
.ps__n{color:var(--line);font-size:var(--nf);line-height:1;font-weight:300}
.ps__c{display:flex;flex-direction:column;gap:10px}
.ps__t{color:#000;font-size:30px;line-height:1.4;font-weight:400}
.ps__d{color:var(--gray);font-size:16px;line-height:1.8}
.ps__cta{grid-column:2;margin-left:calc(var(--nw) + 21px);width:260px;height:80px;padding:0}
@media (max-width:1679px){.ps{--W:1440px;--gl:385px;--tl:41px;--nw:324px;--cw:670px}}
@media (max-width:1439px){.ps{--W:1360px;--gl:365px;--tl:40px;--nw:304px;--cw:631px}}
@media (max-width:1359px){.ps{--W:1200px;--gl:325px;--tl:39px;--nw:264px;--cw:550px;--nf:60px}}
/* FAQ (Tilda T585) */
.fq{padding:0 20px}
.fq__i{border-top:1px solid #dadada}
.fq__q{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:27px 0;color:#000;font-size:16px;line-height:1.8;cursor:pointer;list-style:none}
.fq__q::-webkit-details-marker{display:none}
.fq__ic{position:relative;flex:none;width:34px;height:34px;border-radius:50%;transition:background-color .2s ease-in-out}
.fq__ic::before,.fq__ic::after{content:"";position:absolute;top:50%;left:50%;width:22px;height:2px;margin:-1px 0 0 -11px;background:var(--dark);transition:transform .5s ease}
.fq__ic::after{transform:rotate(90deg)}
.fq__q:hover .fq__ic{background:var(--accent)}
.fq__q:hover .fq__ic::before,.fq__q:hover .fq__ic::after{background:#222}
.fq__i.is-open .fq__ic::after{transform:rotate(0)}
.fq__w{overflow:hidden}
.fq__a{padding-bottom:27px;color:var(--gray);font-size:16px;line-height:1.8}
@media (max-width:1199px){
  .sh__h{max-width:none}
  .sh__btn{margin-top:10px}
  .sv{border-radius:10px}
  .ps{--W:960px;--gl:365px;--tl:53px}
  .ps__in{grid-template-columns:var(--gl) 607px}
  .ps__i{display:flex;flex-direction:column;gap:21px}
  .ps__n{font-size:30px}
  .ps__c{gap:5px}
  .ps__cta{margin-left:0;width:180px;height:60px}
}
@media (max-width:959px){
  .sh{gap:20px}
  .sh__btn{align-self:stretch}
  .sc,.sf,.sf__list{flex-direction:column;gap:20px}
  .sf__list>li{width:auto}
  .st{grid-template-columns:1fr}
  .ps{--W:640px}
  .ps__in{grid-template-columns:600px;padding-left:20px}
  .ps__h{padding-left:0;margin-bottom:-10px}
  .ps__i,.ps__i:first-child,.ps__cta{grid-column:1;grid-row:auto}
  .ps__i{gap:5px}
}
@media (max-width:639px){.ps{--W:480px}.ps__in{grid-template-columns:441px}}
@media (max-width:480px){
  .sb{padding-top:var(--ptm,var(--pt,0));padding-bottom:var(--pbm,var(--pb,0))}
  .ps__in{padding-top:60px}
  .ps__i{padding-bottom:30px}
  .st__img{border-radius:10px 10px 0 0}
}
@media (max-width:479px){
  .s-h,.sh__h,.ps__h{font-size:30px}
  .ps{--W:320px}
  .ps__in{grid-template-columns:280px}
  .ps__h{margin-bottom:18px}
  .ps__cta{width:280px}
}
</style>
