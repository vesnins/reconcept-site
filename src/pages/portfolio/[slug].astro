---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { casePages, type Block, type CasePage } from '../../data/case-pages';

export const getStaticPaths = () => Object.entries(casePages).map(([slug, page]) => ({ params: { slug }, props: { page } }));
const { page } = Astro.props as { page: CasePage };

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/cases/*/*.{jpg,png,webp,svg}', { eager: true });
const pic = (n: string) => Object.entries(files).find(([p]) => p.includes(`/cases/${n}.`))![1].default;
const W = [640, 960, 1280, 1680, 1904];
const FULL = '(max-width:1680px) calc(100vw - 40px), 1640px';
const HALF = '(max-width:1199px) calc(100vw - 40px), calc(50vw - 50px)';
const gp = (b: Block) => b.k === 'img' && b.gap ? [`--g:${b.gap[0]}px`, `--gm:${b.gap[1] ?? b.gap[0]}px`] : b.k === 'pairs' && b.gap != null ? [`--g:${b.gap}px`, `--gm:${b.gap}px`] : [];
const st = (b: Block) => [...gp(b), `--pt:${b.pad[0]}px`, `--pb:${b.pad[1]}px`, b.pad[2] != null && `--ptm:${b.pad[2]}px`, b.pad[3] != null && `--pbm:${b.pad[3]}px`, b.bg && `background:${b.bg}`].filter(Boolean).join(';');
---
<Base title={page.title} description={page.description}>
  {page.blocks.map((b) => (
    <section class:list={['cb', { 'cb--full': b.k === 'tiles' }]} style={st(b)}>
      {b.k === 'video' && <div class:list={['cv', { 'cv--r': b.r }]} style={b.ratio && `aspect-ratio:${b.ratio}`}><iframe src={`https://kinescope.io/embed/${b.id}?autoplay=1&muted=1&loop=1`} title={page.title} loading="lazy" allow="autoplay; fullscreen; picture-in-picture; encrypted-media"></iframe></div>}
      {b.k === 'intro' && <div class="ct ct--intro"><h1 class="ct__h" set:html={b.h} /><p class="ct__p" set:html={b.html} /><p class="ct__p ct__year">{b.year}</p></div>}
      {b.k === 'text' && <div class:list={['ct', { 'ct--r': b.right }]}>{b.h && <h2 class="ct__h" set:html={b.h} />}<div class="ct__p" set:html={b.html} /></div>}
      {b.k === 'img' && <div class:list={['ci', { 'ci--r': b.r }]}>{b.img.map((n) => <Image class="ci__img" src={pic(n)} alt="" widths={W} sizes={FULL} loading="lazy" />)}</div>}
      {b.k === 'pairs' && <div class:list={['ci ci--pairs', b.al && `ci--${b.al}`, { 'ci--r': b.r }]}>{b.img.map((row) => <div class="ci__row">{row.map((n) => n ? <Image class="ci__img" src={pic(n)} alt="" widths={W} sizes={HALF} loading="lazy" /> : <div class="ci__ph" />)}</div>)}</div>}
      {b.k === 'tiles' && <div class="tg" style={`--c:${b.c}`}>{b.img.map((n) => <Image class="tg__img" src={pic(n)} alt="" widths={[480, 640, 960]} sizes={`(max-width:960px) 50vw, ${100 / b.c}vw`} loading="lazy" />)}</div>}
      {b.k === 'site' && <a class="cs" href={b.href}>смотреть сайт<i aria-hidden="true"></i></a>}
    </section>
  ))}
</Base>
<style is:global>
/* Страница кейса — Tilda Zero-блоки кейсов (Freeul) */
.cb{padding:var(--pt,0) 20px var(--pb,0)}
.cv{aspect-ratio:16/10;overflow:hidden;box-shadow:0 10px 40px rgba(0,11,48,.25)}
.cv iframe{display:block;width:100%;height:100%;border:0}
.ct{display:flex;flex-direction:column;gap:20px;width:calc(50% - 10px)}
.ct--intro{gap:30px}
.ct--r{margin-left:auto}
.ct__h{color:#000;font-size:50px;line-height:1.4;font-weight:400}
.ct__p{color:#000;font-size:16px;line-height:1.8}
.ct__p ul{padding-left:20px;list-style:disc}
.ct__year{color:var(--gray)}
.cb--full{padding-left:0;padding-right:0}
.ci{display:flex;flex-direction:column;gap:var(--g,120px)}
.ci--pairs{gap:var(--g,60px)}
.ci__row{display:flex;align-items:center;gap:var(--g,60px)}
.ci--start .ci__row{align-items:flex-start}
.ci--end .ci__row{align-items:flex-end}
.ci__img{width:100%;min-width:0}
.ci__row>*{flex:1}
.tg{display:grid;grid-template-columns:repeat(var(--c),1fr);gap:1px;padding:1px 1px 0}
.tg__img{width:100%;aspect-ratio:1;object-fit:cover}
.cs{display:flex;justify-content:center;align-items:center;gap:5px;padding:75px 20px;border:2px solid var(--accent-hover);border-radius:100px;color:#000;font-size:50px;line-height:1.55;text-transform:lowercase;white-space:nowrap;transition:background-color .2s ease-in-out}
.cs:hover{background:var(--accent-hover)}
.cs i{width:50px;height:50px;flex:none;background:currentColor;-webkit-mask:var(--arw) center/contain no-repeat;mask:var(--arw) center/contain no-repeat;animation:cs-y 2s linear infinite}
@keyframes cs-y{50%{transform:translateY(-3px)}}
@media (max-width:1199px){
  .ct{width:auto}
  .ci,.ci__row{gap:var(--gm,60px)}
  .ci__row{flex-direction:column}
  .ci__row>*{flex:none}
  .ci__ph{display:none}
  .cs{padding:30px 20px;font-size:16px}
  .cs i{width:20px;height:20px}
}
@media (min-width:960px) and (max-width:1199px){.cv--r,.ci--r .ci__img{border-radius:10px}}
@media (max-width:960px){.tg{grid-template-columns:1fr 1fr;gap:0;padding:0}}
@media (max-width:959px){.ct--intro{gap:20px}}
@media (max-width:480px){.cb{padding-top:var(--ptm,var(--pt,0));padding-bottom:var(--pbm,var(--pb,0))}}
@media (max-width:479px){.ct__h{font-size:30px}}
</style>
