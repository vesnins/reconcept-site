---
import BlogShell from '../../components/BlogShell.astro';
import { POSTS, type Post } from '../../data/blog';
export const getStaticPaths = () => POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
const { post } = Astro.props as { post: Post };
---
<BlogShell post={post} />
